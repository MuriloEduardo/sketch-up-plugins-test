# frozen_string_literal: true

# GERADO por tools/sketchup/install-dev-loader.sh — NÃO EDITE (reinstale).
#
# Loader de DESENVOLVIMENTO: carrega as extensões direto do repositório no WSL
# em vez de uma cópia instalada, e liga a ponte de desenvolvimento
# (tools/sketchup/dev_bridge.rb) que permite executar Ruby neste SketchUp a
# partir do terminal (`make su-eval`). Nunca distribua este arquivo.
#
# Mexe no $LOAD_PATH de propósito (proibido em extensões publicadas, aceitável
# num loader local de desenvolvimento, como o dos tutoriais oficiais).

module MuriloEduardoDev
  REPO = '__REPO__'
  SOURCE = File.join(REPO, 'src')
  DEVBRIDGE_DIR = '__DEVBRIDGE__'

  $LOAD_PATH << SOURCE unless $LOAD_PATH.include?(SOURCE)

  Dir.glob(File.join(SOURCE, '*.rb')).each { |file| require file }

  load File.join(REPO, 'tools', 'sketchup', 'dev_bridge.rb')
  Bridge.start(DEVBRIDGE_DIR)

  # Recarrega os arquivos de implementação (não os de registro) após editar.
  # No Ruby Console: MuriloEduardoDev.reload
  #
  # @return [Integer] número de arquivos recarregados
  def self.reload
    original_verbose = $VERBOSE
    $VERBOSE = nil
    files = Dir.glob(File.join(SOURCE, '*', '**', '*.rb'))
    files.each { |file| load file }
    files.size
  ensure
    $VERBOSE = original_verbose
  end
end
